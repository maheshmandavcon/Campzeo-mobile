{
  "expo": {
    "name": "Campzeo",
    "slug": "campzeo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-images/app-logo.png",
    "scheme": "campzeo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandavconsultancy.campzeo"
    },
    "android": {
      "package": "com.mandavconsultancy.campzeo",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app-images/app-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "campzeo"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-images/app-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-images/camp-logo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0f1115"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./network_security_config.xml"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://campzeo.com/api/",
      "router": {},
      "mobileApiKey": "YEKa-f39c7b12e84d56a1c92f0b4c77e9d3",
      "eas": {
        "projectId": "872fa55d-43d2-4a89-b9fb-5c356b8fdc89"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "campzeo-app"
  }
}
